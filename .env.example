# Copy to .env to override defaults. .env is ignored by git.

# Backend database. docker-compose sets this to the bundled PostgreSQL service;
# without it the backend falls back to a local SQLite file.
DATABASE_URL=postgresql+psycopg://trueavail:trueavail@localhost:5432/trueavail

# Frontend -> backend base URL (baked into the frontend at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
