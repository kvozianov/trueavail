{
  "name": "liquidity-control-tower",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "backend:dev": "uvicorn backend.liquidity_control_tower.api:app --reload --port 8000",
    "backend:forecast": "python3 -m backend.scripts.run_phase1_demo",
    "backend:optimizer": "python3 -m backend.scripts.run_phase2_optimizer_demo",
    "backend:demo": "python3 -m backend.scripts.run_phase3_backend_demo",
    "backend:council": "python3 -m backend.scripts.run_ai_council_demo",
    "backend:contracts": "python3 -m backend.scripts.export_ui_contracts",
    "backend:verify": "npm run backend:forecast && npm run backend:optimizer && npm run backend:demo && AI_COUNCIL_PROVIDER=mock npm run backend:council && npm run backend:contracts && npm run backend:test",
    "backend:test": "python3 -m unittest discover backend/tests -v"
  },
  "dependencies": {
    "@splinetool/react-spline": "^4.1.0",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.40.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
