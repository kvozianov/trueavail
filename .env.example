# Copy this file to .env and fill local secrets.
# .env is ignored by git.

# Optional live backend proxy.
# Leave empty for Vercel/static demo mode: /api/backend/* serves deterministic artifacts.
BACKEND_URL=

# Optional Spline scene for the landing blockchain rail.
NEXT_PUBLIC_BLOCKCHAIN_SPLINE_SCENE=https://prod.spline.design/aM3hme8b4yErQ5I5/scene.splinecode

# Optional local override for the demo treasury ledger JSON store.
# Vercel uses writable scratch space automatically when this is empty.
TREASURY_LEDGER_DATA_DIR=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Optional future provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# AI Council controls.
AI_COUNCIL_MODE=auto
AI_COUNCIL_PROVIDER=auto
AI_COUNCIL_PEER_REVIEW=true
AI_COUNCIL_SCENARIO=target2_outage
AI_COUNCIL_DOWNGRADE_BANK=atlas
